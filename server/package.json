{
  "name": "openenvelope-server",
  "version": "0.1.0",
  "description": "Self-hostable backend for OpenEnvelope, an open-source email tracker for Gmail",
  "type": "module",
  "main": "src/index.js",
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/index.js",
