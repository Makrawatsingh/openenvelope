# Public https URL of this server (used in pixel/link URLs)
BASE_URL=https://openenvelope.example.com
PORT=8787
DATA_DIR=./data
# Long random string; used to hash visitor IPs
IP_SALT=replace-with-a-long-random-string
# hash (default) | full | none
IP_MODE=hash
# Bearer token allowed to create users via POST /api/users
ADMIN_TOKEN=replace-me
ALLOW_SIGNUP=false
# Optional SMTP for reports, email alerts and SMTP campaigns. Gmail: use an App Password.
SMTP_URL=
SMTP_FROM=
# Comma-separated list of allowed origins for the API, or *
CORS_ORIGINS=*
